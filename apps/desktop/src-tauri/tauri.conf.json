{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Manager",
  "version": "0.1.0",
  "identifier": "com.loorenz.sessionmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Session Manager", "width": 1100, "height": 720 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": [] } }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "13.0" }
  }
}

