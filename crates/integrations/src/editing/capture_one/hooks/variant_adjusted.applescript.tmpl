on run argv
    try
        tell application "Capture One"
            set v to primary variant
            set variantId to id of v as text
            set rawPath to POSIX path of (path of parent image of v)
        end tell
        set payload to "{\"hook\":\"variant_adjusted\",\"variant_id\":\"" & my jsonEscape(variantId) & "\",\"raw\":\"" & my jsonEscape(rawPath) & "\"}"
        my emitJSON(payload, "variant_adjusted")
    end try
end run

on jsonEscape(v)
    set out to ""
    repeat with ch in characters of (v as text)
        set c to ch as text
        if c is "\"" then
            set out to out & "\\\""
        else if c is "\\" then
            set out to out & "\\\\"
        else if c is return then
            set out to out & "\\r"
        else if c is linefeed then
            set out to out & "\\n"
        else if c is tab then
            set out to out & "\\t"
        else
            set out to out & c
        end if
    end repeat
    return out
end jsonEscape

on emitJSON(payload, hookName)
    set stamp to do shell script "/usr/bin/perl -MTime::HiRes=time -e 'printf \"%016d-%d\", time()*1000000, $$'"
    set basePath to "{{SPOOL_DIR}}/" & stamp & "-" & hookName & ".json"
    set tmpPath to basePath & ".tmp"
    set f to open for access (POSIX file tmpPath) with write permission
    write payload to f as «class utf8»
    close access f
    do shell script "/bin/mv " & quoted form of tmpPath & " " & quoted form of basePath
    do shell script "curl -s -m 1 http://127.0.0.1:{{PORT}}/nudge >/dev/null 2>&1 &"
end emitJSON
