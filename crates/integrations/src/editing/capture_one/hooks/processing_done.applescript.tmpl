on run argv
    try
        set jobId to item 1 of argv as text
        set rawPath to item 2 of argv as text
        set outputArgs to {}
        if (count of argv) is greater than 2 then
            set thirdArg to item 3 of argv
            if class of thirdArg is list then
                set outputArgs to thirdArg
            else
                repeat with idx from 3 to count of argv
                    set end of outputArgs to item idx of argv as text
                end repeat
            end if
        end if
        set vals to {}
        repeat with x in outputArgs
            set end of vals to "\"" & my jsonEscape(x as text) & "\""
        end repeat
        set AppleScript's text item delimiters to ","
        set joined to vals as text
        set AppleScript's text item delimiters to ""
        set payload to "{\"hook\":\"processing_done\",\"job\":\"" & my jsonEscape(jobId) & "\",\"raw\":\"" & my jsonEscape(rawPath) & "\",\"outputs\":[" & joined & "]}"
        my emitJSON(payload, "processing_done")
    end try
end run

on jsonEscape(v)
    set out to ""
    repeat with ch in characters of (v as text)
        set c to ch as text
        if c is "\"" then
            set out to out & "\\\""
        else if c is "\\" then
            set out to out & "\\\\"
        else if c is return then
            set out to out & "\\r"
        else if c is linefeed then
            set out to out & "\\n"
        else if c is tab then
            set out to out & "\\t"
        else
            set out to out & c
        end if
    end repeat
    return out
end jsonEscape

on emitJSON(payload, hookName)
    set stamp to do shell script "/usr/bin/perl -MTime::HiRes=time -e 'printf \"%016d-%d\", time()*1000000, $$'"
    set basePath to "{{SPOOL_DIR}}/" & stamp & "-" & hookName & ".json"
    set tmpPath to basePath & ".tmp"
    set f to open for access (POSIX file tmpPath) with write permission
    write payload to f as «class utf8»
    close access f
    do shell script "/bin/mv " & quoted form of tmpPath & " " & quoted form of basePath
    do shell script "curl -s -m 1 http://127.0.0.1:{{PORT}}/nudge >/dev/null 2>&1 &"
end emitJSON
